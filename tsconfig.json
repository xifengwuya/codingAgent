{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true, // 跳过所有第三方库的类型检查（核心修复）
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client", "node"],
    "paths": {
      "#types/*": ["./node_modules/vite/dist/node/types/*"]
    },
    // 新增：忽略特定库的类型错误
    "ignoreDeprecations": "5.0",
    "noErrorTruncation": true
  },
  "include": ["src/**/*"], // 移除 vite.config.ts，不检查配置文件
  "exclude": ["node_modules", "vite.config.ts"] // 排除配置文件的类型检查
}